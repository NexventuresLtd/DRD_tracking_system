# Reticulum bridge node configuration for DRD Tracking System
# Place this file at ~/.reticulum/config  OR pass it via RNS_CONFIG_DIR env var
#
# Interface selection — enable ONE section matching your hardware:

[reticulum]
  enable_transport = True
  share_instance    = False
  # Allow RNS to store peer state between restarts
  panic_on_interface_error = False

# ── UDP interface (LAN / development / WiFi mesh) ────────────────────────────
[interfaces]

  [[UDP Bridge Interface]]
    type      = UDPInterface
    enabled   = true
    listen_ip = 0.0.0.0
    listen_port = 4242
    forward_ip   = 255.255.255.255
    forward_port = 4242

# ── Serial / LoRa (RNODE hardware) ───────────────────────────────────────────
# Uncomment and edit when using a hardware radio
#
#  [[LoRa Radio]]
#    type       = RNodeInterface
#    enabled    = false
#    port       = /dev/ttyUSB0
#    frequency  = 868000000
#    bandwidth  = 125000
#    txpower    = 7
#    spreadingfactor = 8
#    codingrate = 5

# ── TCP client (connect to an existing Reticulum hub) ────────────────────────
#
#  [[Hub TCP]]
#    type    = TCPClientInterface
#    enabled = false
#    target_host = 192.168.1.100
#    target_port = 4242
