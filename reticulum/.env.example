# DRD Reticulum Bridge — environment config
# Copy this file to .env and fill in real values before running start_bridge.sh

# FastAPI server base URL (no trailing slash)
API_BASE_URL=http://127.0.0.1:8000

# Service-account JWT — generate with:
#   POST /api/v1/auth/login  →  use a coordinator account
#   copy the access_token from the response
API_TOKEN=

# WebSocket broadcast URL
WS_URL=ws://127.0.0.1:8000/ws/events

# Reticulum app name and aspect
RNS_APP_NAME=drd
RNS_APP_ASPECT=bridge

# Path to Reticulum config directory
RNS_CONFIG_DIR=/home/youruser/.reticulum

# Persistent identity file — keeps bridge hash constant across restarts
RNS_IDENTITY_PATH=/home/youruser/.reticulum/drd_bridge_identity

# Announce interval in seconds (phones discover bridge via announces)
ANNOUNCE_INTERVAL=300

# Logging level: DEBUG | INFO | WARNING
BRIDGE_LOG_LEVEL=INFO
